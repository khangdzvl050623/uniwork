# Moi truong chay: development | test | production
NODE_ENV=development

# Cong server lang nghe. Tren Render, bien nay do nen tang tu chen vao.
PORT=4000

# Dia chi bind. Phai la 0.0.0.0 khi chay trong container, khong duoc dung localhost.
HOST=0.0.0.0

# Cac origin duoc phep goi API, ngan cach bang dau phay.
# Khi deploy, doi thanh URL that cua web tren Vercel.
CORS_ORIGIN=http://localhost:5173
