# Moi truong chay: development | test | production
NODE_ENV=development

# Cong server lang nghe. Tren Render, bien nay do nen tang tu chen vao.
PORT=4000

# Dia chi bind. Phai la 0.0.0.0 khi chay trong container, khong duoc dung localhost.
HOST=0.0.0.0

# Cac origin duoc phep goi API, ngan cach bang dau phay.
# Khi deploy, doi thanh URL that cua web tren Vercel.
CORS_ORIGIN=http://localhost:5173

# Database.
# - Local: tro toi container Postgres do docker-compose.yml dung len.
#   Cong 5433 chu khong phai 5432 mac dinh, vi 5432 thuong bi ban Postgres cai
#   san tren may chiem. Noi nham vao do se bao "Authentication failed".
# - Production: dan chuoi ket noi cua Neon vao day, nho giu ?sslmode=require
DATABASE_URL=postgresql://uniwork:uniwork_dev@localhost:5433/uniwork

# Chuoi ket noi danh rieng cho migration.
# - Local: giong het DATABASE_URL, vi khong co PgBouncer nao o giua.
# - Production: dung chuoi Neon KHONG co chu `-pooler` trong hostname.  
DIRECT_URL=postgresql://uniwork:uniwork_dev@localhost:5433/uniwork

# --------------------------------------------------------------- Sprint 1 ---

# Chuoi ky JWT. Sinh bang: openssl rand -base64 48
JWT_ACCESS_SECRET=thay-bang-chuoi-ngau-nhien-it-nhat-32-ky-tu-aaaaaa

# Han access token. Ngan de gioi han thiet hai khi token bi lo — no khong thu
# hoi duoc, chi co the doi no het han.
ACCESS_TTL=15m

# Han refresh token, tinh bang ngay. Truot theo hoat dong, khong dem tu luc
# dang nhap — xem giai thich day du trong config/env.ts.
REFRESH_TTL_DAYS=7

# Khoa gui email (brevo.com), muc Transactional > SMTP & API > API keys.
# Goi free 300 email/ngay. Chi can xac thuc DIA CHI GUI, khong gioi han nguoi nhan.
BREVO_API_KEY=xkeysib-thay-bang-khoa-that-khi-co

# Dia chi web, dung ghep link trong email.
APP_URL=http://localhost:5173

# Dia chi dung ten gui email. PHAI duoc xac thuc trong Brevo:
# Settings > Senders, Domains & Dedicated IPs > Senders
# Dung email cua truong hay Gmail deu duoc — Brevo se tu doi ten mien nguoi
# gui thanh @brevosend.com vi ban khong so huu ten mien do.
MAIL_FROM=email-da-xac-thuc-cua-ban@example.com

# Cloudinary — noi luu CV that (T56). Lay ca 3 gia tri o Dashboard sau khi
# tao tai khoan free tai cloudinary.com.
# Chua co khoa that thi app van chay: uploadCv se ghi log thay vi goi that,
# xem lib/cloudinary.ts.
CLOUDINARY_CLOUD_NAME=thay-bang-cloud-name-that
CLOUDINARY_API_KEY=thay-bang-api-key-that
CLOUDINARY_API_SECRET=thay-bang-api-secret-that

# Dia chi cong khai cua chinh API nay. Dung de dung redirect_uri cho Google.
# Local giu nguyen; khi deploy doi thanh https://<ten>.onrender.com
API_URL=http://localhost:4000

# Dang nhap Google (console.cloud.google.com).
# De TRONG thi nut "Dang nhap bang Google" tu an di, cac cach dang nhap khac
# van chay binh thuong - khong bat buoc phai co de chay du an.
#
# Cach lay: Google Cloud Console > APIs & Services > Credentials
#   > Create credentials > OAuth client ID > Web application
# Muc "Authorized redirect URIs" phai dien CHINH XAC (ke ca dau gach cheo):
#   http://localhost:4000/api/auth/google/callback
#   https://<ten>.onrender.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Tai khoan admin tu tao luc khoi dong NEU CHUA CO AI (Render free khong co
# Shell de tu chay script tay). Chi TAO, khong bao gio CAP NHAT - da co roi thi
# giu nguyen mai mai, ke ca ban da doi mat khau.
#
# Bo trong thi dung mac dinh: AdminUniWork@gmail.com / admin@123
# Doi mat khau NGAY qua "Quen mat khau" sau lan dang nhap dau tien tren
# production - gia tri mac dinh nam trong ma nguon cong khai.
ADMIN_EMAIL=
ADMIN_PASSWORD=
