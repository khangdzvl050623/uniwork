    {
      "name": "09 — Gửi mã OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/gui-otp",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "gui-otp"
          ]
        },
        "description": "Cần đăng nhập trước (chạy 01 hoặc 04). Endpoint CỐ Ý không nhận email trong body — nếu nhận thì ai cũng gọi được và nó thành công cụ dò email + máy gửi thư rác."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Ngoài production, API trả kèm devCode để khỏi phải mở hộp thư.",
              "// Ở production trường này không bao giờ có.",
              "if (pm.response.code === 200 && pm.response.json().data.devCode) {",
              "  pm.collectionVariables.set('otpCode', pm.response.json().data.devCode)",
              "}",
              "",
              "pm.test('trả 200', () => pm.response.to.have.status(200))",
              "",
              "pm.test('mã gồm đúng 6 chữ số', () => {",
              "  const code = pm.response.json().data.devCode",
              "  pm.expect(code).to.match(/^\\d{6}$/)",
              "})"
            ]
          }
        }
      ]
    },
